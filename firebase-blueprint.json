{
  "entities": {
    "SchoolTenant": {
      "title": "SchoolTenant",
      "description": "Multi-tenant school account and subscription state",
      "type": "object",
      "properties": {
        "schoolId": { "type": "string", "pattern": "^SCH[0-9]{3,}$" },
        "schoolCode": { "type": "string", "maxLength": 64 },
        "schoolName": { "type": "string", "maxLength": 200 },
        "address": { "type": "string", "maxLength": 500 },
        "contactNumber": { "type": "string", "maxLength": 40 },
        "email": { "type": "string", "format": "email" },
        "principalName": { "type": "string", "maxLength": 150 },
        "adminName": { "type": "string", "maxLength": 150 },
        "adminEmail": { "type": "string", "format": "email" },
        "adminUid": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["pending", "active", "expired", "suspended"] }
      },
      "required": ["schoolId", "schoolCode", "schoolName", "status"]
    },
    "SubscriptionPlan": {
      "title": "SubscriptionPlan",
      "description": "Platform SaaS subscription plan catalog",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" },
        "name": { "type": "string" },
        "nameBn": { "type": "string" },
        "durationDays": { "type": "number" },
        "priceBdt": { "type": "number" },
        "discountPercent": { "type": "number" },
        "badgeText": { "type": "string" },
        "features": { "type": "array" },
        "sortOrder": { "type": "number" },
        "isCustom": { "type": "boolean" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "name", "durationDays", "priceBdt"]
    },
    "PaymentRequest": {
      "title": "PaymentRequest",
      "description": "Manual subscription payment request (bKash, Nagad, Bank Transfer)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "schoolId": { "type": "string" },
        "planId": { "type": "string" },
        "amount": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["bKash", "Nagad", "Bank Transfer"] },
        "senderNumber": { "type": "string" },
        "transactionId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] }
      },
      "required": ["id", "schoolId", "planId", "amount", "transactionId", "status"]
    },
    "SubscriptionHistory": {
      "title": "SubscriptionHistory",
      "description": "Audit log of school subscription activations, renewals, and suspensions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "schoolId": { "type": "string" },
        "eventType": { "type": "string" },
        "planId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "schoolId", "eventType", "createdAt"]
    },
    "SaaSUser": {
      "title": "SaaSUser",
      "description": "Firebase Auth provisioned school user without plaintext password",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "username": { "type": "string" },
        "usernameNormalized": { "type": "string" },
        "phoneNormalized": { "type": "string" },
        "displayName": { "type": "string" },
        "schoolId": { "type": "string" },
        "schoolRole": { "type": "string" },
        "phone": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "disabled"] }
      },
      "required": ["uid", "email", "schoolId", "schoolRole", "status"]
    },
    "TenantSlice": {
      "title": "TenantSlice",
      "description": "Tenant-isolated ERP data slice stored under schools/{schoolId}/slices",
      "type": "object",
      "properties": {
        "schoolId": { "type": "string" },
        "slice": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["schoolId", "slice"]
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "Two-way support conversation thread between a school user and Master Admin",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "schoolId": { "type": "string" },
        "schoolName": { "type": "string" },
        "schoolCode": { "type": "string" },
        "createdByUid": { "type": "string" },
        "createdByName": { "type": "string" },
        "createdByEmail": { "type": "string" },
        "createdByRole": { "type": "string" },
        "subject": { "type": "string", "maxLength": 240 },
        "category": { "type": "string", "enum": ["technical", "billing", "training", "data", "other"] },
        "status": { "type": "string", "enum": ["open", "replied", "resolved"] },
        "lastMessagePreview": { "type": "string", "maxLength": 500 },
        "lastSenderRole": { "type": "string", "enum": ["school", "master_admin"] },
        "unreadByMaster": { "type": "boolean" },
        "unreadBySchool": { "type": "boolean" },
        "messageCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": [
        "id",
        "schoolId",
        "schoolName",
        "createdByUid",
        "createdByEmail",
        "createdByRole",
        "subject",
        "category",
        "status",
        "lastSenderRole",
        "unreadByMaster",
        "unreadBySchool",
        "messageCount",
        "createdAt",
        "updatedAt"
      ]
    },
    "SupportMessage": {
      "title": "SupportMessage",
      "description": "Individual message inside a support ticket with optional compressed screenshot attachments",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ticketId": { "type": "string" },
        "schoolId": { "type": "string" },
        "ticketCreatorUid": { "type": "string" },
        "senderUid": { "type": "string" },
        "senderName": { "type": "string" },
        "senderEmail": { "type": "string" },
        "senderRole": { "type": "string", "enum": ["school", "master_admin"] },
        "senderSchoolRole": { "type": "string" },
        "text": { "type": "string", "maxLength": 3500 },
        "imageUrls": { "type": "array", "maxItems": 3 },
        "createdAt": { "type": "string" }
      },
      "required": [
        "id",
        "ticketId",
        "schoolId",
        "senderUid",
        "senderName",
        "senderRole",
        "text",
        "imageUrls",
        "createdAt"
      ]
    },
    "SupportVideo": {
      "title": "SupportVideo",
      "description": "Sanitized YouTube tutorial video embeds uploaded by Master Admin for school Super Admins and Admins",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 180 },
        "description": { "type": "string", "maxLength": 1000 },
        "category": {
          "type": "string",
          "enum": ["getting_started", "fees", "attendance", "exams", "students", "settings", "other"]
        },
        "videoId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]{11}$" },
        "embedUrl": { "type": "string", "maxLength": 300 },
        "watchUrl": { "type": "string", "maxLength": 300 },
        "thumbnailUrl": { "type": "string", "maxLength": 300 },
        "audience": { "type": "string", "enum": ["admins", "all"] },
        "sortOrder": { "type": "number" },
        "isActive": { "type": "boolean" },
        "createdByUid": { "type": "string", "maxLength": 128 },
        "createdByName": { "type": "string", "maxLength": 150 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": [
        "id",
        "title",
        "category",
        "videoId",
        "embedUrl",
        "watchUrl",
        "thumbnailUrl",
        "audience",
        "sortOrder",
        "isActive",
        "createdByUid",
        "createdByName",
        "createdAt",
        "updatedAt"
      ]
    },
    "StaffHRDocument": {
      "title": "StaffHRDocument",
      "description": "Official school teacher and staff HR document (Appointment, Joining, Resignation, Release, Experience, Promotion, Transfer, Increment, Warning, Show Cause)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "schoolId": { "type": "string", "maxLength": 128 },
        "employeeId": { "type": "string", "maxLength": 128 },
        "employeeAuthUid": { "type": "string", "maxLength": 128 },
        "employeeCode": { "type": "string", "maxLength": 64 },
        "employeeName": { "type": "string", "maxLength": 150 },
        "documentType": {
          "type": "string",
          "enum": [
            "appointment_letter",
            "joining_letter",
            "resignation_letter",
            "resignation_acceptance",
            "release_letter",
            "experience_certificate",
            "promotion_letter",
            "transfer_letter",
            "salary_increment_letter",
            "warning_letter",
            "show_cause_notice"
          ]
        },
        "documentNumber": { "type": "string", "maxLength": 80 },
        "issueDate": { "type": "string", "maxLength": 32 },
        "language": { "type": "string", "enum": ["bn", "en"] },
        "templateId": { "type": "string", "maxLength": 128 },
        "approvalStatus": { "type": "string", "enum": ["Pending", "Approved", "Rejected", "Issued"] },
        "approvalNote": { "type": "string", "maxLength": 1000 },
        "approvedByUid": { "type": "string", "maxLength": 128 },
        "approvedByName": { "type": "string", "maxLength": 150 },
        "approvedAt": { "type": "string", "maxLength": 64 },
        "createdByUid": { "type": "string", "maxLength": 128 },
        "createdBy": { "type": "string", "maxLength": 150 },
        "createdByRole": { "type": "string", "maxLength": 40 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "documentData": { "type": "object" },
        "auditLogs": { "type": "array" }
      },
      "required": [
        "id",
        "schoolId",
        "employeeId",
        "employeeCode",
        "employeeName",
        "documentType",
        "documentNumber",
        "issueDate",
        "approvalStatus",
        "createdByUid",
        "createdBy",
        "createdAt",
        "updatedAt",
        "documentData"
      ]
    },
    "StaffDocumentTemplate": {
      "title": "StaffDocumentTemplate",
      "description": "Customizable A4 letterhead template for school HR documents",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "schoolId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 120 },
        "styleTheme": {
          "type": "string",
          "enum": ["classic_navy_gold", "modern_institutional", "minimal_official", "bordered_certificate"]
        },
        "language": { "type": "string", "enum": ["bn", "en"] },
        "fontFamily": { "type": "string", "maxLength": 120 },
        "logoPosition": { "type": "string", "enum": ["left", "center", "right"] },
        "showLogo": { "type": "boolean" },
        "showHeader": { "type": "boolean" },
        "headerSubtitle": { "type": "string", "maxLength": 240 },
        "showFooter": { "type": "boolean" },
        "footerText": { "type": "string", "maxLength": 300 },
        "signaturePosition": { "type": "string", "enum": ["left", "center", "right"] },
        "sealPosition": { "type": "string", "enum": ["left", "center", "right"] },
        "showSeal": { "type": "boolean" },
        "sealLabel": { "type": "string", "maxLength": 120 },
        "primaryColor": { "type": "string", "maxLength": 24 },
        "accentColor": { "type": "string", "maxLength": 24 },
        "marginTopMm": { "type": "number" },
        "marginRightMm": { "type": "number" },
        "marginBottomMm": { "type": "number" },
        "marginLeftMm": { "type": "number" },
        "isDefault": { "type": "boolean" },
        "createdByUid": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": [
        "id",
        "schoolId",
        "name",
        "styleTheme",
        "language",
        "fontFamily",
        "logoPosition",
        "signaturePosition",
        "sealPosition",
        "createdAt",
        "updatedAt"
      ]
    },
    "StaffResignation": {
      "title": "StaffResignation",
      "description": "Teacher and staff resignation submission and Principal review workflow",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "schoolId": { "type": "string", "maxLength": 128 },
        "employeeId": { "type": "string", "maxLength": 128 },
        "employeeAuthUid": { "type": "string", "maxLength": 128 },
        "employeeCode": { "type": "string", "maxLength": 64 },
        "employeeName": { "type": "string", "maxLength": 150 },
        "designation": { "type": "string", "maxLength": 120 },
        "department": { "type": "string", "maxLength": 120 },
        "resignationReason": { "type": "string", "maxLength": 2000 },
        "applicationDate": { "type": "string", "maxLength": 32 },
        "proposedLastWorkingDate": { "type": "string", "maxLength": 32 },
        "noticePeriod": { "type": "string", "maxLength": 80 },
        "employeeSignature": { "type": "string", "maxLength": 150 },
        "principalRemarks": { "type": "string", "maxLength": 1000 },
        "approvalStatus": { "type": "string", "enum": ["Pending", "Approved", "Rejected"] },
        "reviewedByUid": { "type": "string", "maxLength": 128 },
        "reviewedByName": { "type": "string", "maxLength": 150 },
        "reviewedAt": { "type": "string", "maxLength": 64 },
        "linkedDocumentId": { "type": "string", "maxLength": 128 },
        "linkedDocumentNumber": { "type": "string", "maxLength": 80 },
        "createdByUid": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "auditLogs": { "type": "array" }
      },
      "required": [
        "id",
        "schoolId",
        "employeeId",
        "employeeCode",
        "employeeName",
        "resignationReason",
        "applicationDate",
        "proposedLastWorkingDate",
        "approvalStatus",
        "createdByUid",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/schools/{schoolId}": {
      "schema": "SchoolTenant",
      "description": "Multi-tenant school root records and subscription state"
    },
    "/schools/{schoolId}/slices/{sliceId}": {
      "schema": "TenantSlice",
      "description": "Isolated school ERP slices per tenant"
    },
    "/schools/{schoolId}/users/{uid}": {
      "schema": "SaaSUser",
      "description": "School-scoped provisioned user directory"
    },
    "/schools/{schoolId}/staffDocuments/{docId}": {
      "schema": "StaffHRDocument",
      "description": "School-isolated Teacher and Staff HR documents"
    },
    "/schools/{schoolId}/staffDocumentTemplates/{templateId}": {
      "schema": "StaffDocumentTemplate",
      "description": "Customizable HR document templates per school"
    },
    "/schools/{schoolId}/staffResignations/{resignationId}": {
      "schema": "StaffResignation",
      "description": "Staff resignation submissions and approval workflow records"
    },
    "/subscription_plans/{planId}": {
      "schema": "SubscriptionPlan",
      "description": "Platform subscription plans"
    },
    "/payment_requests/{requestId}": {
      "schema": "PaymentRequest",
      "description": "Manual subscription renewal payment requests"
    },
    "/subscription_history/{historyId}": {
      "schema": "SubscriptionHistory",
      "description": "Immutable subscription audit trail"
    },
    "/saas_users/{uid}": {
      "schema": "SaaSUser",
      "description": "Global user-to-school index"
    },
    "/support_tickets/{ticketId}": {
      "schema": "SupportTicket",
      "description": "Two-way school support tickets"
    },
    "/support_tickets/{ticketId}/messages/{messageId}": {
      "schema": "SupportMessage",
      "description": "Support chat messages with screenshot attachments"
    },
    "/support_videos/{videoId}": {
      "schema": "SupportVideo",
      "description": "YouTube tutorial video embeds uploaded by Master Admin"
    }
  }
}
